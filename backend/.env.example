TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Optional: 여행 코스(Gemini 무료 등급). 비우면 코스 기능을 끈다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
REDIS_URL=redis://127.0.0.1:6379/0
SLACK_WEBHOOK_URL=
# Optional: nonstandard Chrome install. The scanner starts its own temporary headless profile.
CHROME_PATH=
# Optional: 배포용 회원 전용 모드(Supabase Auth). 두 값이 모두 있어야 로그인 확인이 켜지고,
# 그때만 아래 호스트·출처로 외부 접근을 연다. 비우면 127.0.0.1 전용·로그인 없음.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 스캐너 서버의 공개 호스트 이름(쉼표 구분, 예: scanner.example.com)
FLIGHT_WATCH_ALLOWED_HOSTS=
# 화면 출처(쉼표 구분, 예: https://flight-watch.vercel.app)
FLIGHT_WATCH_CORS_ORIGINS=
