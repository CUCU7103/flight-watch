# 공인 IP의 점을 하이픈으로 바꾼 sslip.io 이름(도메인 없이 HTTPS 인증서를 받는다). 예: 158-180-1-2.sslip.io
SCANNER_HOST=
# Vercel 화면 주소(쉼표 구분)
FLIGHT_WATCH_CORS_ORIGINS=
