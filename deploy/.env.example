SUPABASE_PUBLISHABLE_KEY=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# Optional: 여행 코스(Gemini 무료 등급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
